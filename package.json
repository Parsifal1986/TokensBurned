{
  "name": "tokensburned",
  "version": "0.6.0",
  "description": "Privacy-first AI coding activity for your GitHub profile.",
  "type": "module",
  "bin": {
    "burn": "bin/burn.js",
    "tokensburned": "bin/burn.js"
  },
  "scripts": {
    "start": "node ./bin/burn.js",
    "dev": "node ./scripts/serve.js",
    "worker:dev": "wrangler dev --config ./serverless/wrangler.toml",
    "worker:migrate:local": "wrangler d1 migrations apply tokensburned --local --config ./serverless/wrangler.toml",
    "worker:preflight": "node ./scripts/production-preflight.mjs",
    "worker:backfill:legacy": "node ./scripts/backfill-legacy-d1.mjs",
    "worker:totals:rebuild": "node ./scripts/rebuild-materialized-totals.mjs",
    "worker:rankings": "node ./scripts/materialize-rankings.mjs",
    "worker:version:upload": "wrangler versions upload --strict --keep-vars --config ./serverless/wrangler.toml",
    "worker:versions:list": "wrangler versions list --config ./serverless/wrangler.toml",
    "worker:deploy": "wrangler deploy --config ./serverless/wrangler.toml",
    "demo:cards": "node ./scripts/build-demo-cards.js",
    "plugin:sync": "node ./scripts/sync-plugin-runtime.js",
    "test": "node --test",
    "check": "node --check ./bin/burn.js && node --test"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "codex",
    "claude-code",
    "github-profile",
    "tokens",
    "developer-tools"
  ],
  "homepage": "https://tokensburned.com/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Parsifal1986/TokensBurned.git"
  },
  "bugs": {
    "url": "https://github.com/Parsifal1986/TokensBurned/issues"
  },
  "license": "MIT",
  "cline": {
    "plugins": [
      {
        "paths": [
          "./integrations/cline/plugin.js"
        ],
        "capabilities": [
          "hooks"
        ]
      }
    ]
  },
  "peerDependencies": {
    "@cline/sdk": "*"
  },
  "peerDependenciesMeta": {
    "@cline/sdk": {
      "optional": true
    }
  },
  "files": [
    "bin",
    "src",
    "public",
    "scripts/hook.js",
    "scripts/onboarding.js",
    "scripts/sync-plugin-runtime.js",
    "skills",
    "hooks",
    ".codex-plugin",
    ".claude-plugin",
    "commands",
    "examples",
    "integrations",
    "gemini-extension.json",
    ".plugin",
    "README.md",
    "SECURITY.md",
    "LICENSE"
  ],
  "devDependencies": {
    "wrangler": "^4.127.1"
  }
}
